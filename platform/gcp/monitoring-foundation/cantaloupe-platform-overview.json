        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "Cantaloupe 단일 Kubernetes 클러스터의 AWS/GCP/On-prem 운영 상태와 용량을 platform, role, namespace 기준으로 확인한다. 비용과 애플리케이션 비즈니스 지표는 별도 대시보드에서 관리한다.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 0},
      "id": 100,
      "panels": [],
      "title": "Cluster Health",
      "type": "row"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "선택한 platform/role의 Ready 노드 수와 전체 노드 수다.",
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "mappings": [], "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}, "unit": "short"}, "overrides": []},
      "gridPos": {"h": 5, "w": 3, "x": 0, "y": 1},
      "id": 1,
      "options": {"colorMode": "value", "graphMode": "none", "justifyMode": "center", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "value_and_name", "wideLayout": true},
      "targets": [
        {"expr": "sum(kube_node_status_condition{condition=\"Ready\",status=\"true\"} * on(node) group_left(label_platform,label_role) kube_node_labels{label_platform=~\"$platform\",label_role=~\"$role\"})", "instant": true, "legendFormat": "Ready", "refId": "A"},
        {"expr": "count(kube_node_info * on(node) group_left(label_platform,label_role) kube_node_labels{label_platform=~\"$platform\",label_role=~\"$role\"})", "instant": true, "legendFormat": "Total", "refId": "B"}
      ],
      "title": "Ready / Total Nodes",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "선택한 namespace와 platform/role에서 Running 상태인 Pod 수다.",
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]}, "unit": "short"}, "overrides": []},
      "gridPos": {"h": 5, "w": 3, "x": 3, "y": 1},
      "id": 2,
      "options": {"colorMode": "value", "graphMode": "none", "justifyMode": "center", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto", "wideLayout": true},
      "targets": [{"expr": "sum(kube_pod_status_phase{namespace=~\"$namespace\",phase=\"Running\"} * on(namespace,pod) group_left(node) kube_pod_info * on(node) group_left(label_platform,label_role) kube_node_labels{label_platform=~\"$platform\",label_role=~\"$role\"})", "instant": true, "refId": "A"}],
      "title": "Running Pods",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "현재 Pending phase인 Pod 수다. 아직 Node에 배치되지 않은 Unschedulable Pod도 놓치지 않도록 namespace 기준으로 집계한다. 0보다 크면 상세 패널에서 reason을 확인한다.",
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "links": [{"title": "Pending Pod 상세 보기", "url": "/grafana/d/cantaloupe-platform-overview/cantaloupe-platform-overview?viewPanel=18&${namespace:queryparam}&${platform:queryparam}&${role:queryparam}"}], "noValue": "0", "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 1}, {"color": "red", "value": 3}]}, "unit": "short"}, "overrides": []},
      "gridPos": {"h": 5, "w": 3, "x": 6, "y": 1},
      "id": 3,
      "options": {"colorMode": "background", "graphMode": "none", "justifyMode": "center", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto", "wideLayout": true},
      "targets": [{"expr": "sum(kube_pod_status_phase{namespace=~\"$namespace\",phase=\"Pending\"} == 1)", "instant": true, "refId": "A"}],
      "title": "Pending Pods",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "현재 Failed 상태인 Pod 수다.",
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "links": [{"title": "Failed Pod 상세 보기", "url": "/grafana/d/cantaloupe-platform-overview/cantaloupe-platform-overview?viewPanel=18&${namespace:queryparam}&${platform:queryparam}&${role:queryparam}"}], "noValue": "0", "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}]}, "unit": "short"}, "overrides": []},
      "gridPos": {"h": 5, "w": 3, "x": 9, "y": 1},
      "id": 4,
      "options": {"colorMode": "background", "graphMode": "none", "justifyMode": "center", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto", "wideLayout": true},
      "targets": [{"expr": "sum(kube_pod_status_phase{namespace=~\"$namespace\",phase=\"Failed\"} == 1)", "instant": true, "refId": "A"}],
      "title": "Failed Pods",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "최근 1시간 Container restart counter 증가량이다. 값을 클릭하면 재시작한 namespace/pod/container 상세 표를 연다.",
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "decimals": 0, "links": [{"title": "재시작 Container 상세 보기", "url": "/grafana/d/cantaloupe-platform-overview/cantaloupe-platform-overview?viewPanel=15&${namespace:queryparam}&${platform:queryparam}&${role:queryparam}"}], "noValue": "0", "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 1}, {"color": "red", "value": 5}]}, "unit": "short"}, "overrides": []},
      "gridPos": {"h": 5, "w": 3, "x": 12, "y": 1},
      "id": 5,
      "options": {"colorMode": "background", "graphMode": "area", "justifyMode": "center", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto", "wideLayout": true},
      "targets": [{"expr": "round(sum(increase(kube_pod_container_status_restarts_total{namespace=~\"$namespace\"}[1h])))", "instant": true, "refId": "A"}],
      "title": "Restarts (1h)",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "마지막 종료 원인이 OOMKilled인 Container 수다.",
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "links": [{"title": "OOMKilled 상세 보기", "url": "/grafana/d/cantaloupe-platform-overview/cantaloupe-platform-overview?viewPanel=18&${namespace:queryparam}&${platform:queryparam}&${role:queryparam}"}], "noValue": "0", "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}]}, "unit": "short"}, "overrides": []},
      "gridPos": {"h": 5, "w": 3, "x": 15, "y": 1},
      "id": 6,
      "options": {"colorMode": "background", "graphMode": "none", "justifyMode": "center", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto", "wideLayout": true},
      "targets": [{"expr": "count(kube_pod_container_status_last_terminated_reason{namespace=~\"$namespace\",reason=\"OOMKilled\"} == 1)", "instant": true, "refId": "A"}],
      "title": "Last OOMKilled",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "스토리지와 아직 Bound되지 못한 PVC 수다. 값을 클릭하면 PVC명, namespace, StorageClass 상세 표를 연다.",
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "links": [{"title": "Pending PVC 상세 보기", "url": "/grafana/d/cantaloupe-platform-overview/cantaloupe-platform-overview?viewPanel=25&${namespace:queryparam}"}], "noValue": "0", "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}]}, "unit": "short"}, "overrides": []},
      "gridPos": {"h": 5, "w": 3, "x": 18, "y": 1},
      "id": 7,
      "options": {"colorMode": "background", "graphMode": "none", "justifyMode": "center", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto", "wideLayout": true},
      "targets": [{"expr": "count(kube_persistentvolumeclaim_status_phase{namespace=~\"$namespace\",phase=\"Pending\"} == 1)", "instant": true, "refId": "A"}],
      "title": "Pending PVCs",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "Prometheus가 현재 scrape하지 못하는 Target 수다. 0이 정상이다.",
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "links": [{"title": "Down Target 상세 보기", "url": "/grafana/d/cantaloupe-platform-overview/cantaloupe-platform-overview?viewPanel=26"}], "noValue": "0", "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}]}, "unit": "short"}, "overrides": []},
      "gridPos": {"h": 5, "w": 3, "x": 21, "y": 1},
      "id": 8,
      "options": {"colorMode": "background", "graphMode": "none", "justifyMode": "center", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto", "wideLayout": true},
      "targets": [{"expr": "count(up == 0)", "instant": true, "refId": "A"}],
      "title": "Targets Down",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "상단 카드는 현재 상태이고, 이 그래프는 Grafana에서 선택한 시간 범위의 상태 변화를 보여준다. Last 1 hour는 최근 1시간, Last 6 hours는 최근 6시간의 과거 구간까지 조회한다. Restart는 각 표시 간격에서 증가한 횟수다.",
      "fieldConfig": {"defaults": {"color": {"mode": "palette-classic"}, "custom": {"drawStyle": "line", "fillOpacity": 15, "lineInterpolation": "stepAfter", "lineWidth": 2, "showPoints": "never", "spanNulls": true}, "decimals": 0, "min": 0, "unit": "short"}, "overrides": []},
      "gridPos": {"h": 6, "w": 24, "x": 0, "y": 6},
      "id": 28,
      "options": {"legend": {"calcs": ["max", "lastNotNull"], "displayMode": "table", "placement": "right", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [
        {"expr": "sum(((1 - kube_node_status_condition{condition=\"Ready\",status=\"true\"}) == 1) * on(node) group_left(label_platform,label_role) kube_node_labels{label_platform=~\"$platform\",label_role=~\"$role\"})", "legendFormat": "Not Ready Nodes", "refId": "A"},
        {"expr": "sum(kube_pod_status_phase{namespace=~\"$namespace\",phase=\"Pending\"} == 1)", "legendFormat": "Pending Pods", "refId": "B"},
        {"expr": "sum(kube_pod_status_phase{namespace=~\"$namespace\",phase=\"Failed\"} == 1)", "legendFormat": "Failed Pods", "refId": "C"},
        {"expr": "sum(increase(kube_pod_container_status_restarts_total{namespace=~\"$namespace\"}[$__rate_interval]))", "legendFormat": "Container Restarts / interval", "refId": "D"}
      ],
      "title": "Health History — Selected Time Range",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 12},
      "id": 200,
      "panels": [],
      "title": "Platform Capacity & FinOps Signals",
      "type": "row"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "플랫폼·역할별 CPU Allocatable 대비 Request 예약률과 Container Actual 사용률을 같은 분모로 비교한다. 둘의 큰 차이는 Kubernetes FinOps의 P95·비용 분석으로 연결하되, 이 화면만으로 Right-sizing을 확정하지 않는다.",
      "fieldConfig": {"defaults": {"color": {"mode": "palette-classic"}, "min": 0, "max": 100, "unit": "percent"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 13},
      "id": 9,
      "options": {"displayMode": "gradient", "minVizHeight": 12, "minVizWidth": 0, "orientation": "horizontal", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "showUnfilled": true, "valueMode": "color"},
      "targets": [
        {"expr": "100 * sum by (label_platform,label_role) (kube_pod_container_resource_requests{namespace=~\"$namespace\",resource=\"cpu\",unit=\"core\"} * on(node) group_left(label_platform,label_role) kube_node_labels{label_platform=~\"$platform\",label_role=~\"$role\"}) / sum by (label_platform,label_role) (kube_node_status_allocatable{resource=\"cpu\",unit=\"core\"} * on(node) group_left(label_platform,label_role) kube_node_labels{label_platform=~\"$platform\",label_role=~\"$role\"})", "legendFormat": "{{label_platform}} / {{label_role}} — Request", "refId": "A"},
        {"expr": "100 * sum by (label_platform,label_role) (rate(container_cpu_usage_seconds_total{namespace=~\"$namespace\",container!=\"\",container!=\"POD\",image!=\"\"}[5m]) * on(node) group_left(label_platform,label_role) kube_node_labels{label_platform=~\"$platform\",label_role=~\"$role\"}) / sum by (label_platform,label_role) (kube_node_status_allocatable{resource=\"cpu\",unit=\"core\"} * on(node) group_left(label_platform,label_role) kube_node_labels{label_platform=~\"$platform\",label_role=~\"$role\"})", "legendFormat": "{{label_platform}} / {{label_role}} — Workload Actual", "refId": "B"}
      ],
      "title": "Platform CPU — Request vs Workload / Allocatable",
      "type": "bargauge"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "플랫폼·역할별 Memory Allocatable 대비 Request 예약률과 Container Actual 사용률을 같은 분모로 비교한다. Request가 없는 control-plane Container 때문에 Actual/Request가 왜곡되는 문제를 피한다.",
      "fieldConfig": {"defaults": {"color": {"mode": "palette-classic"}, "min": 0, "max": 100, "unit": "percent"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 13},
      "id": 10,
      "options": {"displayMode": "gradient", "minVizHeight": 12, "minVizWidth": 0, "orientation": "horizontal", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "showUnfilled": true, "valueMode": "color"},
      "targets": [
        {"expr": "100 * sum by (label_platform,label_role) (kube_pod_container_resource_requests{namespace=~\"$namespace\",resource=\"memory\",unit=\"byte\"} * on(node) group_left(label_platform,label_role) kube_node_labels{label_platform=~\"$platform\",label_role=~\"$role\"}) / sum by (label_platform,label_role) (kube_node_status_allocatable{resource=\"memory\",unit=\"byte\"} * on(node) group_left(label_platform,label_role) kube_node_labels{label_platform=~\"$platform\",label_role=~\"$role\"})", "legendFormat": "{{label_platform}} / {{label_role}} — Request", "refId": "A"},
        {"expr": "100 * sum by (label_platform,label_role) (container_memory_working_set_bytes{namespace=~\"$namespace\",container!=\"\",container!=\"POD\",image!=\"\"} * on(node) group_left(label_platform,label_role) kube_node_labels{label_platform=~\"$platform\",label_role=~\"$role\"}) / sum by (label_platform,label_role) (kube_node_status_allocatable{resource=\"memory\",unit=\"byte\"} * on(node) group_left(label_platform,label_role) kube_node_labels{label_platform=~\"$platform\",label_role=~\"$role\"})", "legendFormat": "{{label_platform}} / {{label_role}} — Workload Actual", "refId": "B"}
      ],
      "title": "Platform Memory — Request vs Workload / Allocatable",
      "type": "bargauge"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "node-exporter가 측정한 Node 전체 non-idle CPU 사용률이다. OS와 Kubernetes 워크로드 사용량을 함께 포함한다.",
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "min": 0, "max": 100, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 70}, {"color": "red", "value": 85}]}, "unit": "percent"}, "overrides": []},
      "gridPos": {"h": 7, "w": 12, "x": 0, "y": 21},
      "id": 11,
      "options": {"displayMode": "gradient", "minVizHeight": 10, "minVizWidth": 0, "orientation": "horizontal", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "showUnfilled": true, "valueMode": "color"},
      "targets": [{"expr": "(100 * (1 - avg by (instance) (rate(node_cpu_seconds_total{mode=\"idle\"}[$__rate_interval])))) * on(instance) group_left(node) label_replace(node_uname_info, \"node\", \"$1\", \"nodename\", \"(.*)\") * on(node) group_left(label_platform,label_role) kube_node_labels{label_platform=~\"$platform\",label_role=~\"$role\"}", "legendFormat": "{{node}}", "refId": "A"}],
      "title": "Node CPU Utilization (Host)",
      "type": "bargauge"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "node-exporter 기준 Node 전체 Memory 사용률이다. (MemTotal - MemAvailable) / MemTotal로 계산한다.",
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "min": 0, "max": 100, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 70}, {"color": "red", "value": 85}]}, "unit": "percent"}, "overrides": []},
      "gridPos": {"h": 7, "w": 12, "x": 12, "y": 21},
      "id": 12,
      "options": {"displayMode": "gradient", "minVizHeight": 10, "minVizWidth": 0, "orientation": "horizontal", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "showUnfilled": true, "valueMode": "color"},
      "targets": [{"expr": "(100 * (1 - node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)) * on(instance) group_left(node) label_replace(node_uname_info, \"node\", \"$1\", \"nodename\", \"(.*)\") * on(node) group_left(label_platform,label_role) kube_node_labels{label_platform=~\"$platform\",label_role=~\"$role\"}", "legendFormat": "{{node}}", "refId": "A"}],
      "title": "Node Memory Utilization (Host)",
      "type": "bargauge"
    },
    {
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 28},
      "id": 300,
      "panels": [],
      "title": "Workload Health",
      "type": "row"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "Namespace별 Actual과 선언된 Request를 비교한다. Actual / Declared Request가 100%를 넘으면 부하가 Request를 초과했거나 일부 Container에 Request가 없다는 뜻이다. 장기 Right-sizing은 Kubernetes FinOps에서 P95·비용·Request coverage를 함께 판단한다.",
      "fieldConfig": {"defaults": {"custom": {"align": "auto", "cellOptions": {"type": "auto"}, "inspect": false}}, "overrides": [{"matcher": {"id": "byName", "options": "CPU Actual"}, "properties": [{"id": "unit", "value": "cores"}]}, {"matcher": {"id": "byName", "options": "CPU Request"}, "properties": [{"id": "unit", "value": "cores"}]}, {"matcher": {"id": "byName", "options": "CPU / Declared Request"}, "properties": [{"id": "unit", "value": "percent"}]}, {"matcher": {"id": "byName", "options": "Memory Actual"}, "properties": [{"id": "unit", "value": "bytes"}]}, {"matcher": {"id": "byName", "options": "Memory Request"}, "properties": [{"id": "unit", "value": "bytes"}]}, {"matcher": {"id": "byName", "options": "Memory / Declared Request"}, "properties": [{"id": "unit", "value": "percent"}]}]},
      "gridPos": {"h": 10, "w": 24, "x": 0, "y": 29},
      "id": 13,
      "options": {"cellHeight": "sm", "footer": {"countRows": false, "fields": "", "reducer": ["sum"], "show": false}, "showHeader": true, "sortBy": [{"desc": false, "displayName": "Namespace"}]},
      "targets": [
        {"expr": "sum by (namespace) (rate(container_cpu_usage_seconds_total{namespace=~\"$namespace\",container!=\"\",container!=\"POD\",image!=\"\"}[5m]) * on(node) group_left(label_platform,label_role) kube_node_labels{label_platform=~\"$platform\",label_role=~\"$role\"})", "format": "table", "instant": true, "refId": "A"},
        {"expr": "sum by (namespace) (kube_pod_container_resource_requests{namespace=~\"$namespace\",resource=\"cpu\",unit=\"core\"} * on(node) group_left(label_platform,label_role) kube_node_labels{label_platform=~\"$platform\",label_role=~\"$role\"})", "format": "table", "instant": true, "refId": "B"},
        {"expr": "100 * sum by (namespace) (rate(container_cpu_usage_seconds_total{namespace=~\"$namespace\",container!=\"\",container!=\"POD\",image!=\"\"}[5m]) * on(node) group_left(label_platform,label_role) kube_node_labels{label_platform=~\"$platform\",label_role=~\"$role\"}) / sum by (namespace) (kube_pod_container_resource_requests{namespace=~\"$namespace\",resource=\"cpu\",unit=\"core\"} * on(node) group_left(label_platform,label_role) kube_node_labels{label_platform=~\"$platform\",label_role=~\"$role\"})", "format": "table", "instant": true, "refId": "C"},
        {"expr": "sum by (namespace) (container_memory_working_set_bytes{namespace=~\"$namespace\",container!=\"\",container!=\"POD\",image!=\"\"} * on(node) group_left(label_platform,label_role) kube_node_labels{label_platform=~\"$platform\",label_role=~\"$role\"})", "format": "table", "instant": true, "refId": "D"},
        {"expr": "sum by (namespace) (kube_pod_container_resource_requests{namespace=~\"$namespace\",resource=\"memory\",unit=\"byte\"} * on(node) group_left(label_platform,label_role) kube_node_labels{label_platform=~\"$platform\",label_role=~\"$role\"})", "format": "table", "instant": true, "refId": "E"},
