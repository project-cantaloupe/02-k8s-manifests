    {
      "id": 19,
      "title": "Provider 공식 VM 추천",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 10
      },
      "description": "GCP Recommender와 AWS Compute Optimizer의 비민감 Snapshot입니다. AWS 분석 중에는 행이 없고 상단 상태에 analyzing으로 유지됩니다.",
      "targets": [
        {
          "expr": "cantaloupe:provider_vm_recommendation_info{platform=~\"$platform\"}",
          "refId": "A",
          "instant": true,
          "format": "table"
        },
        {
          "expr": "cantaloupe:provider_vm_estimated_monthly_savings{platform=~\"$platform\"}",
          "refId": "B",
          "instant": true,
          "format": "table"
        },
        {
          "expr": "cantaloupe:provider_vm_current_vcpu{platform=~\"$platform\"}",
          "refId": "C",
          "instant": true,
          "format": "table"
        },
        {
          "expr": "cantaloupe:provider_vm_recommended_vcpu{platform=~\"$platform\"}",
          "refId": "D",
          "instant": true,
          "format": "table"
        },
        {
          "expr": "cantaloupe:provider_vm_current_memory_bytes{platform=~\"$platform\"}",
          "refId": "E",
          "instant": true,
          "format": "table"
        },
        {
          "expr": "cantaloupe:provider_vm_recommended_memory_bytes{platform=~\"$platform\"}",
          "refId": "F",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "node",
            "mode": "inner"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value #A": true,
              "priority": true,
              "state": true
            },
            "indexByName": {
              "platform": 0,
              "node": 1,
              "current_profile": 2,
              "recommended_profile": 3,
              "Value #C": 4,
              "Value #D": 5,
              "Value #E": 6,
              "Value #F": 7,
              "Value #B": 8,
              "source": 9
            },
            "renameByName": {
              "platform": "Platform",
              "node": "VM",
              "current_profile": "현재 사양",
              "recommended_profile": "권장 사양",
              "Value #C": "현재 vCPU",
              "Value #D": "권장 vCPU",
              "Value #E": "현재 Memory",
              "Value #F": "권장 Memory",
              "Value #B": "월 예상 절감",
              "source": "Source"
            }
          }
        }
      ],
      "options": {
        "cellHeight": "sm",
        "showHeader": true,
        "footer": {
          "show": false
        },
        "sortBy": [
          {
            "displayName": "월 예상 절감",
            "desc": true
          }
        ]
      },
      "fieldConfig": {
        "defaults": {
          "decimals": 2
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "/.*Memory/"
            },
            "properties": [
              {
                "id": "unit",
                "value": "bytes"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "월 예상 절감"
            },
            "properties": [
              {
                "id": "unit",
                "value": "currencyUSD"
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "colored-background",
                  "mode": "gradient"
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          }
        ]
      }
    },
