          "format": "table"
        },
        {
          "expr": "cantaloupe:onprem_node_required_cpu_cores",
          "refId": "B",
          "instant": true,
          "format": "table"
        },
        {
          "expr": "cantaloupe:onprem_node_recommended_vcpu",
          "refId": "C",
          "instant": true,
          "format": "table"
        },
        {
          "expr": "cantaloupe:onprem_node_required_memory_bytes",
          "refId": "D",
          "instant": true,
          "format": "table"
        },
        {
          "expr": "cantaloupe:onprem_node_recommended_memory_bytes",
          "refId": "E",
          "instant": true,
          "format": "table"
        },
        {
          "expr": "cantaloupe:onprem_node_potential_savings_per_month",
          "refId": "F",
          "instant": true,
          "format": "table"
        },
        {
          "expr": "cantaloupe:onprem_node_recommendation_safe_to_review or on(node) (0 * cantaloupe:onprem_node_recommendation_info)",
          "refId": "G",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "node",
            "mode": "outer"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value #A": true
            },
            "indexByName": {
              "node": 0,
              "recommended_profile": 1,
              "Value #B": 2,
              "Value #C": 3,
              "Value #D": 4,
              "Value #E": 5,
              "Value #F": 6,
              "Value #G": 7
            },
            "renameByName": {
              "node": "Node",
              "recommended_profile": "권장 Profile",
              "Value #B": "필요 CPU",
              "Value #C": "권장 vCPU",
              "Value #D": "필요 Memory",
              "Value #E": "권장 Memory",
              "Value #F": "월 TCO 절감",
              "Value #G": "검토 상태"
            }
          }
        }
      ],
      "options": {
        "cellHeight": "sm",
        "showHeader": true,
        "footer": {
          "show": false
        },
        "sortBy": [
          {
            "displayName": "월 TCO 절감",
            "desc": true
          }
        ]
      },
      "fieldConfig": {
        "defaults": {
          "decimals": 2
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "/.*Memory/"
            },
            "properties": [
              {
                "id": "unit",
                "value": "bytes"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "월 TCO 절감"
            },
            "properties": [
              {
                "id": "unit",
                "value": "currencyUSD"
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "colored-background",
                  "mode": "gradient"
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "purple"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
            "options": "검토 상태"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                          "text": "보류",
                        "color": "orange"
                      },
                      "1": {
                          "text": "검토 가능",
                        "color": "green"
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      }
