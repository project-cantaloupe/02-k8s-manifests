      },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "stat",
      "title": "관측 신뢰도",
      "description": "0 데이터 부족(<6h), 1 초기 후보(6~24h), 2 검토 가능(24h~7d), 3 운영 기준 충족(7d 이상). 권장값과 별개의 안전 판단이다.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "min(cantaloupe:workload_observation_confidence{namespace=~\"$namespace\",workload=~\"$workload\"})",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "value_and_name",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "데이터 없음",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "데이터 부족",
                  "color": "red"
                },
                "1": {
                  "text": "초기 후보",
                  "color": "yellow"
                },
                "2": {
                  "text": "검토 가능",
                  "color": "green"
                },
                "3": {
                  "text": "운영 기준 충족",
                  "color": "green"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red"
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "green",
                "value": 2
              }
            ]
          }
        },
        "overrides": []
      }
    },
