    {
      "id": 401,
      "type": "timeseries",
      "title": "CPU — Actual / Request / VPA Target",
      "description": "Right Sizing 후 실제 CPU 사용량이 변경된 Request에서 안전하게 동작하는지 확인합니다. CPU limit은 설정하지 않습니다.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 27,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "sum(rate(container_cpu_usage_seconds_total{namespace=\"apps\",container=\"transcode\"}[$__rate_interval]))",
          "format": "time_series",
          "instant": false,
          "range": true,
          "refId": "A",
          "legendFormat": "Actual"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "sum(kube_pod_container_resource_requests{namespace=\"apps\",container=\"transcode\",resource=\"cpu\",unit=\"core\"})",
          "format": "time_series",
          "instant": false,
          "range": true,
          "refId": "B",
          "legendFormat": "Request"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "max(cantaloupe:workload_container_vpa_target_cpu_cores{namespace=\"apps\",workload=\"audio-transcode\",container=\"transcode\"})",
          "format": "time_series",
          "instant": false,
          "range": true,
          "refId": "C",
          "legendFormat": "VPA Target"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "cores",
          "decimals": 3,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
