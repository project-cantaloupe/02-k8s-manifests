        "w": 24,
        "h": 1
      }
    },
    {
      "id": 101,
      "type": "stat",
      "title": "요청률",
      "description": "Audio Ingress에서 Web/API로 전달된 최근 5분 평균 요청률입니다.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 3,
        "h": 5
      },
      "targets": [
        {
          "expr": "sum(rate(istio_requests_total{reporter=\"source\",source_workload=\"audio-ingress\",destination_workload_namespace=\"apps\",destination_workload=~\"audio-web|audio-api\"}[5m]))",
          "refId": "A",
          "format": "time_series",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 2,
          "noValue": "0 req/s",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "textMode": "auto",
        "wideLayout": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 102,
      "type": "stat",
      "title": "5xx 오류율",
      "description": "클라이언트 오류(4xx)는 제외한 서비스 장애 비율입니다.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 3,
        "y": 1,
        "w": 3,
        "h": 5
      },
      "targets": [
        {
          "expr": "100 * sum(rate(istio_requests_total{reporter=\"source\",source_workload=\"audio-ingress\",destination_workload_namespace=\"apps\",destination_workload=~\"audio-web|audio-api\",response_code=~\"5..\"}[5m])) / clamp_min(sum(rate(istio_requests_total{reporter=\"source\",source_workload=\"audio-ingress\",destination_workload_namespace=\"apps\",destination_workload=~\"audio-web|audio-api\"}[5m])), 0.000001)",
          "refId": "A",
          "format": "time_series",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 2,
          "noValue": "0%",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "textMode": "auto",
        "wideLayout": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 103,
      "type": "stat",
      "title": "응답 P95",
      "description": "Web/API 요청의 최근 5분 P95 응답시간입니다. 요청이 없으면 '요청 없음'으로 표시합니다.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 6,
        "y": 1,
        "w": 3,
        "h": 5
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by(le) (rate(istio_request_duration_milliseconds_bucket{reporter=\"source\",source_workload=\"audio-ingress\",destination_workload_namespace=\"apps\",destination_workload=~\"audio-web|audio-api\"}[5m]))) and on() (sum(rate(istio_request_duration_milliseconds_count{reporter=\"source\",source_workload=\"audio-ingress\",destination_workload_namespace=\"apps\",destination_workload=~\"audio-web|audio-api\"}[5m])) > 0)",
          "refId": "A",
          "format": "time_series",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "decimals": 0,
          "noValue": "요청 없음",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1000
              },
              {
                "color": "red",
                "value": 3000
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "textMode": "auto",
        "wideLayout": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
