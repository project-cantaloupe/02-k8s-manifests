          "targets": [
            {
              "expr": "max by(phase,run_id) (cantaloupe_audio_finops_run_karpenter_nodes_max)",
              "legendFormat": "{{phase}} / {{run_id}}",
              "refId": "A",
              "format": "time_series",
              "instant": true,
              "range": false
            }
          ],
          "fieldConfig": {
            "defaults": {
              "unit": "short",
              "min": 0,
              "max": 2,
              "decimals": 0,
              "thresholds": {
                "mode": "absolute",
                "steps": [
                  { "color": "green", "value": null },
