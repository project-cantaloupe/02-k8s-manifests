    {
      "id": 301,
      "type": "timeseries",
      "title": "SQS / Transcode / Pending / Karpenter 통합 타임라인",
      "description": "Queue 유입, 전체 Transcode Worker, Pending Transcode, Karpenter Node의 발생 순서와 처리 종료 후 scale-in을 같은 시간축에서 확인합니다. SQS CloudWatch 표본은 약 2분 지연될 수 있습니다.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "max(cantaloupe:aws_sqs_messages_visible{queue_name=\"cntlp-aws-queue-transcode\"}) or vector(0)",
          "format": "time_series",
          "instant": false,
          "range": true,
          "refId": "A",
          "legendFormat": "SQS Queue"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "sum(kube_deployment_status_replicas_available{namespace=\"apps\",deployment=~\"audio-transcode|audio-transcode-burst\"}) or vector(0)",
          "format": "time_series",
          "instant": false,
          "range": true,
          "refId": "B",
          "legendFormat": "Transcode Worker"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "sum(kube_pod_status_phase{namespace=\"apps\",phase=\"Pending\"} * on(namespace,pod) group_left(workload) namespace_workload_pod:kube_pod_owner:relabel{namespace=\"apps\",workload=~\"audio-transcode|audio-transcode-burst\"}) or vector(0)",
          "format": "time_series",
          "instant": false,
          "range": true,
          "refId": "C",
          "legendFormat": "Pending Transcode"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "count(max by(node) (kube_node_labels{label_karpenter_sh_nodepool=\"aws-service\"})) or vector(0)",
          "format": "time_series",
          "instant": false,
          "range": true,
          "refId": "D",
          "legendFormat": "Karpenter Node"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false,
