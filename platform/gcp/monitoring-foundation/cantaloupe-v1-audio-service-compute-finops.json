    {
      "id": 106,
      "type": "stat",
      "title": "안전 이상 여부",
      "description": "OOMKilled, 비정상 Transcode Worker 재시작, Transcode DLQ 중 하나라도 감지되면 1, 모두 정상이면 0입니다. 순간 Pending은 정상 확장 과정으로 보고 지속 Pending 허용시간은 아직 정의되지 않아 현재 판정에서 제외합니다.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 20,
        "y": 1,
        "w": 4,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "clamp_max((round(sum(increase(kube_pod_container_status_restarts_total{namespace=\"apps\",container=\"transcode\"}[$__range]))) or vector(0)) + (sum(max_over_time(kube_pod_container_status_last_terminated_reason{namespace=\"apps\",container=\"transcode\",reason=\"OOMKilled\"}[$__range])) or vector(0)) + (max(max_over_time(cantaloupe:aws_sqs_messages_visible{queue_name=\"cntlp-aws-queue-transcode-dlq\"}[$__range])) or vector(0)), 1)",
          "format": "time_series",
          "instant": true,
          "range": false,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "noValue": "0",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "textMode": "auto",
        "wideLayout": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
