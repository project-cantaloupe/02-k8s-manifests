          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "gridPos": { "x": 12, "y": 66, "w": 12, "h": 7 },
          "targets": [
            {
              "expr": "max by(phase,run_id) (cantaloupe_audio_finops_run_karpenter_node_minutes)",
              "legendFormat": "{{phase}} / {{run_id}}",
              "refId": "A",
