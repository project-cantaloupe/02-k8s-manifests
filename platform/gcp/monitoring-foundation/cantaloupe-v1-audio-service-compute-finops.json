        {
          "expr": "sum by(destination_workload) (rate(istio_requests_total{reporter=\"source\",source_workload=\"audio-ingress\",destination_workload_namespace=\"apps\",destination_workload=~\"audio-web|audio-api\"}[$__rate_interval]))",
